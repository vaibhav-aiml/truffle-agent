# === Groq LLM Configuration ===
# Get your free Groq API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# === OpenAI Embeddings (optional) ===
# If not set, Truffle uses a local hash-based embedding fallback.
OPENAI_API_KEY=your_openai_api_key_here

# === Redis (optional) ===
# If not set, Truffle falls back to thread-safe in-memory cache/rate-limiting.
REDIS_URL=redis://localhost:6379

# === Sentry Error Monitoring (optional) ===
# If not set, crash reporting is disabled.
SENTRY_DSN=

# === Rate Limiting ===
# Maximum requests per user within the sliding window (seconds).
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW=60

# === Cache TTL ===
# How long cached query answers live, in seconds (default: 24 hours).
CACHE_TTL=86400
